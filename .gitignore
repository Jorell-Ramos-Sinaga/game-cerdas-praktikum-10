# This .gitignore file is designed for Unity projects.
# Source: GitHub Unity.gitignore template with modern Unity 6 / IDE additions

# ==========================================
# Unity generated folders
# ==========================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset server cache
/[Aa]sset_Server_Cache/

# Unity serializes autogenerated internal asset IDs in .meta files.
# Do not ignore .meta files in Assets/!

# ==========================================
# Gradle / Android / Package Cache
# ==========================================
.gradle/
/[Aa]ssets/Plugins/Android/assets/

# Package Cache
/[Pp]ackage[Cc]ache/

# ==========================================
# Visual Studio / Visual Studio Code / Rider
# ==========================================
.vs/
.idea/
.vscode/

# Solution & project files (autogenerated by Unity)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler & crash reports
sysinfo.txt
*.stackdump

# ==========================================
# Build Artifacts
# ==========================================
*.apk
*.aab
*.unitypackage
*.app

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==========================================
# Local Scratch / Temporary Files
# ==========================================
extracted_mhtml.txt
extracted_steps.txt
*.log

