<h1 id=3D"115-corridor-width-2">115. Corridor Width 2</h1><p>Contoh modifik=
asi horizontal:</p>
<pre><code class=3D"hljs language-plaintext">private void CarveHorizontalWi=
de(
    int x1,
    int x2,
    int y,
    int width)
{
    int start =3D Mathf.Min(x1, x2);
    int end =3D Mathf.Max(x1, x2);

    for (int x =3D start; x &lt;=3D end; x++)
    {
        for (int offset =3D 0;
             offset &lt; width;
             offset++)
        {
            int targetY =3D y + offset;

            if (IsInsideGrid(x, targetY))
            {
                grid[x, targetY]
                    =3D TileType.Floor;
            }
        }
    }
}</code></pre><hr>
