<h1 id=3D"49-splitnode">49. SplitNode</h1><p>Tambahkan:</p>
<pre><code class=3D"hljs language-plaintext">private void SplitNode(BSPNode=
 node)
{
    if (node.width &lt;=3D maxLeafSize &amp;&amp;
        node.height &lt;=3D maxLeafSize)
    {
        leafNodes.Add(node);
        return;
    }

    bool splitHorizontal;

    if (node.width &gt; node.height * 1.25f)
    {
        splitHorizontal =3D false;
    }
    else if (node.height &gt; node.width * 1.25f)
    {
