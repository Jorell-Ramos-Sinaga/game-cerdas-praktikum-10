<h1 id=3D"54-createrooms">54. CreateRooms</h1><p>Tambahkan:</p>
<pre><code class=3D"hljs language-plaintext">private void CreateRooms()
{
    rooms.Clear();

    foreach (BSPNode leaf in leafNodes)
    {
        int maxWidth =3D leaf.width - roomMargin * 2;
        int maxHeight =3D leaf.height - roomMargin * 2;

